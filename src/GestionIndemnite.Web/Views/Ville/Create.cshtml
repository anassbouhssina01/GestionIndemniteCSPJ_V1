@{
    ViewData["Title"] = "Nouvelle ville";
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">NOUVELLE VILLE</h2>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Index">Retour à la liste</a>
    </div>
</div>

<form method="post" class="panel-card form-panel">
    <div class="form-group">
        <label class="form-label" for="IdPays">Pays</label>
        <select class="form-select" id="IdPays" name="IdPays" asp-items="ViewBag.FiltrePays" required>
            <option value="">— Sélectionner —</option>
        </select>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NomVille">Nom de la ville (français)</label>
            <input class="form-input" id="NomVille" name="NomVille" maxlength="100" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="NomVilleAr">Nom de la ville (arabe)</label>
            <input class="form-input arabic-font" id="NomVilleAr" name="NomVilleAr" maxlength="100" dir="rtl" />
        </div>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="Latitude">Latitude</label>
            <input class="form-input" id="Latitude" name="Latitude" type="number" step="0.000001" />
        </div>
        <div class="form-group">
            <label class="form-label" for="Longitude">Longitude</label>
            <input class="form-input" id="Longitude" name="Longitude" type="number" step="0.000001" />
        </div>
    </div>
    <div class="page-actions-group mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-dark" asp-action="Index">Annuler</a>
    </div>
</form>
