@model IReadOnlyList<GestionIndemnite.Application.RHOrganisation.DTOs.VilleDto>
@{
    ViewData["Title"] = "Villes";
    var inactifs = (bool)(ViewData["Inactifs"] ?? false);
    var idPays = (Guid?)ViewData["IdPays"];
    var pays = (Dictionary<Guid, string>)ViewBag.Pays;
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">PARAMÉTRAGE DES VILLES</h2>
        <p class="page-description">Villes rattachées aux pays enregistrés.</p>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-primary" asp-action="Create">Nouvelle ville</a>
    </div>
</div>

<form method="get" class="filter-toolbar">
    <div class="filter-group">
        <label class="filter-label" for="idPays">Pays</label>
        <select class="form-select" name="idPays" id="idPays" asp-items="ViewBag.FiltrePays" onchange="this.form.submit()">
            <option value="">Tous les pays</option>
        </select>
    </div>
    <div class="filter-group">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="inactifs" value="true" id="inactifs" @(inactifs ? "checked" : "") onchange="this.form.submit()" />
            <label class="form-check-label" for="inactifs">Afficher les inactives</label>
        </div>
    </div>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Nom (arabe)</th>
                    <th>Pays</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>État</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted">Aucune ville.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NomVille</td>
                        <td dir="rtl">@(string.IsNullOrWhiteSpace(item.NomVilleAr) ? "—" : item.NomVilleAr)</td>
                        <td>@(pays.TryGetValue(item.IdPays, out var nomPays) ? nomPays : item.IdPays.ToString())</td>
                        <td>@item.Latitude</td>
                        <td>@item.Longitude</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge-statut-pill green">Actif</span>
                            }
                            else
                            {
                                <span class="badge-statut-pill gray">Inactif</span>
                            }
                        </td>
                        <td class="text-right">
                            <a class="btn-table-action" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>
                            @if (item.IsActive)
                            {
                                <form method="post" asp-action="Disable" asp-route-id="@item.Id">
                                    <button type="submit" class="btn-table-action danger">Désactiver</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="Enable" asp-route-id="@item.Id">
                                    <button type="submit" class="btn-table-action">Activer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
