@model GestionIndemnite.Application.RHOrganisation.DTOs.FonctionnaireDto
@{
    ViewData["Title"] = "Modifier le fonctionnaire";
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">MODIFIER LE FONCTIONNAIRE</h2>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@Model.Id">Retour à la fiche</a>
    </div>
</div>

<form method="post" asp-route-id="@Model.Id" class="panel-card form-panel-wide">
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label">Matricule</label>
            <input class="form-input" value="@Model.Matricule" readonly />
        </div>
        <div class="form-group">
            <label class="form-label">CIN</label>
            <input class="form-input" value="@Model.Cin" readonly />
        </div>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NomFr">Nom (français)</label>
            <input class="form-input" id="NomFr" name="NomFr" maxlength="100" value="@Model.NomFr" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="PrenomFr">Prénom (français)</label>
            <input class="form-input" id="PrenomFr" name="PrenomFr" maxlength="100" value="@Model.PrenomFr" required />
        </div>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NomAr">Nom (arabe)</label>
            <input class="form-input arabic-font" id="NomAr" name="NomAr" maxlength="100" dir="rtl" value="@Model.NomAr" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="PrenomAr">Prénom (arabe)</label>
            <input class="form-input arabic-font" id="PrenomAr" name="PrenomAr" maxlength="100" dir="rtl" value="@Model.PrenomAr" required />
        </div>
    </div>
    <div class="form-grid-3">
        <div class="form-group">
            <label class="form-label" for="DateNaissance">Date de naissance</label>
            <input class="form-input" type="date" id="DateNaissance" name="DateNaissance"
                   value="@Model.DateNaissance.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="DateRecrutement">Date de recrutement</label>
            <input class="form-input" type="date" id="DateRecrutement" name="DateRecrutement"
                   value="@Model.DateRecrutement.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="Genre">Genre</label>
            <select class="form-select" id="Genre" name="Genre" asp-items="ViewBag.Genres" required></select>
        </div>
    </div>
    <div class="page-actions-group mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@Model.Id">Annuler</a>
    </div>
</form>
