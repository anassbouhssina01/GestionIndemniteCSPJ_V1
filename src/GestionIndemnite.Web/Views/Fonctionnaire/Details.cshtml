@model GestionIndemnite.Web.Models.DossierFonctionnaireViewModel
@using GestionIndemnite.Domain.RHOrganisation.Enums
@{
    ViewData["Title"] = "Dossier du fonctionnaire";
    var f = Model.Fonctionnaire;
    var genreFr = f.Genre == Genre.Masculin ? "Masculin" : "Féminin";
    var p0 = !string.IsNullOrWhiteSpace(f.PrenomFr) ? f.PrenomFr.Substring(0, 1) : string.Empty;
    var n0 = !string.IsNullOrWhiteSpace(f.NomFr) ? f.NomFr.Substring(0, 1) : string.Empty;
    var initiales = (p0 + n0).ToUpperInvariant();
    var aujourdHui = DateTime.Today.ToString("yyyy-MM-dd");

    var gradeActuel = Model.GradeActuel;
    var situationActuelle = Model.SituationActuelle;
    var affectationActuelle = Model.AffectationActuelle;

    var gradeDto = gradeActuel is null ? null : Model.GradeOf(gradeActuel.IdGrade);
    var statutDto = situationActuelle is null ? null : Model.StatutOf(situationActuelle.IdStatut);
    var cadreDto = gradeDto is null ? null : Model.CadreOf(gradeDto.IdCadre);
    var villeDto = affectationActuelle is null ? null : Model.VilleOfAffectation(affectationActuelle);

    var gradeActuelLibelle = gradeDto is null
        ? "—"
        : $"{gradeDto.LibelleGradeFr} ({gradeDto.NumeroReferencie})";
    var statutActuelLibelle = statutDto is null ? "Non défini" : statutDto.LibelleStatutFr;
    var statutActuelCode = statutDto is null ? "—" : statutDto.CodeStatut;
    var affectationActuelleLibelle = affectationActuelle is null ? "—" : Model.AffectationLabel(affectationActuelle);

    Func<Guid, string> gradeLabel = id =>
    {
        var g = Model.GradeOf(id);
        return g is null ? "—" : $"{g.LibelleGradeFr} ({g.NumeroReferencie})";
    };
    Func<Guid, string> statutLabel = id =>
    {
        var s = Model.StatutOf(id);
        return s is null ? "—" : $"{s.LibelleStatutFr} ({s.CodeStatut})";
    };
    Func<Guid, string> responsabiliteLabel = id =>
    {
        var r = Model.ResponsabiliteOf(id);
        return r is null ? "—" : $"{r.LibelleResponsabiliteFr} ({r.CodeResponsabilite})";
    };
}

<!-- ===== BANNIÈRE PROFIL (template) ===== -->
<div class="profile-hero-card">
    <div class="hero-left">
        <div class="profile-avatar-circle">@initiales</div>
        <div class="hero-names">
            <h2 class="hero-person-name">@f.NomFr @f.PrenomFr</h2>
            <div class="hero-badges-row">
                <span class="badge-matricule-hero">@f.Matricule</span>
                <span class="badge-cin-hero">CIN : @f.Cin</span>
                <span class="badge-status-hero">@statutActuelCode</span>
            </div>
        </div>
    </div>
    <div class="hero-right">
        <div class="arabic-hero-name">@f.NomAr @f.PrenomAr</div>
        <a class="btn btn-hero-back" asp-action="Index">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Retour</span>
        </a>
    </div>
</div>

<!-- ===== BARRE D'ACTIONS (template) ===== -->
<div class="profile-actions-bar">
    <div class="actions-left">
        <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@f.Id">Modifier</a>
        <button type="button" class="btn btn-outline-dark" onclick="openDossierModal('modal-affecter')">Affecter</button>
        <button type="button" class="btn btn-outline-dark" onclick="openDossierModal('modal-responsabilite')">Responsabilité</button>
        <button type="button" class="btn btn-outline-dark" onclick="openDossierModal('modal-changer-grade')">Changer de grade</button>
        <button type="button" class="btn btn-outline-dark" onclick="openDossierModal('modal-situation')">Ouvrir une situation</button>
        <button type="button" class="btn btn-outline-dark" onclick="window.print()" title="Imprimer la fiche individuelle">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            <span>Imprimer</span>
        </button>
    </div>
    <div class="actions-right">
        <form method="post" asp-action="Delete" asp-route-id="@f.Id"
              onsubmit="return confirm('Confirmer la suppression de ce fonctionnaire ?');">
            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
        </form>
    </div>
</div>

<!-- ===== ONGLETS (template) ===== -->
<div class="profile-tabs-header" id="dossier-tabs">
    <button type="button" class="profile-tab active" data-tab="tab-general">Informations générales</button>
    <button type="button" class="profile-tab" data-tab="tab-grade">Grade &amp; carrière</button>
    <button type="button" class="profile-tab" data-tab="tab-responsabilites">Responsabilités</button>
    <button type="button" class="profile-tab" data-tab="tab-affectation">Affectation</button>
    <button type="button" class="profile-tab" data-tab="tab-situation">Situation</button>
    <button type="button" class="profile-tab" data-tab="tab-rib">RIB</button>
</div>

<!-- ===== ONGLET 1 : INFORMATIONS GÉNÉRALES ===== -->
<div id="tab-general" class="profile-tab-content active">
    <div class="cards-highlight-grid">
        <div class="info-metric-card">
            <span class="info-metric-label">NAISSANCE</span>
            <span class="info-metric-val">@f.DateNaissance.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="info-metric-card">
            <span class="info-metric-label">RECRUTEMENT</span>
            <span class="info-metric-val">@f.DateRecrutement.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="info-metric-card highlight-blue">
            <span class="info-metric-label">GRADE ACTUEL</span>
            <span class="info-metric-val val-blue">@gradeActuelLibelle</span>
        </div>
        <div class="info-metric-card highlight-green">
            <span class="info-metric-label">STATUT</span>
            <div>
                <span class="badge-status-green">@statutActuelLibelle</span>
            </div>
        </div>
    </div>

    <div class="info-panels-grid">
        <div class="panel-card">
            <h4 class="panel-card-title">État civil &amp; Identité</h4>
            <div class="key-value-list">
                <div class="kv-item"><span class="k">Nom (Français) :</span><span class="v">@f.NomFr</span></div>
                <div class="kv-item"><span class="k">Prénom (Français) :</span><span class="v">@f.PrenomFr</span></div>
                <div class="kv-item"><span class="k">الاسم العائلي :</span><span class="v arabic-text" dir="rtl">@f.NomAr</span></div>
                <div class="kv-item"><span class="k">الاسم الشخصي :</span><span class="v arabic-text" dir="rtl">@f.PrenomAr</span></div>
                <div class="kv-item"><span class="k">CIN :</span><span class="v">@f.Cin</span></div>
                <div class="kv-item"><span class="k">Matricule CSPJ :</span><span class="v">@f.Matricule</span></div>
                <div class="kv-item"><span class="k">Genre :</span><span class="v">@genreFr</span></div>
            </div>
        </div>

        <div class="panel-card">
            <h4 class="panel-card-title">Affectation institutionnelle &amp; Cadre</h4>
            <div class="key-value-list">
                <div class="kv-item"><span class="k">Cadre professionnel :</span><span class="v">@(cadreDto?.LibelleCadreFr ?? "—")</span></div>
                <div class="kv-item"><span class="k">Tribunal / Unité :</span><span class="v">@affectationActuelleLibelle</span></div>
                <div class="kv-item">
                    <span class="k">Section :</span>
                    <span class="v">@(affectationActuelle is null ? "—" : DossierFonctionnaireViewModel.SectionLabel(affectationActuelle.SectionTribunal))</span>
                </div>
                <div class="kv-item">
                    <span class="k">Unité de travail :</span>
                    <span class="v">@(affectationActuelle is null ? "—" : Model.UniteOf(affectationActuelle.IdUniteTravail)?.NomUnite ?? "—")</span>
                </div>
                <div class="kv-item"><span class="k">Ville d'exercice :</span><span class="v">@(villeDto?.NomVille ?? "—")</span></div>
                <div class="kv-item">
                    <span class="k">Affecté depuis :</span>
                    <span class="v">@(affectationActuelle is null ? "—" : affectationActuelle.DateDebut.ToString("dd/MM/yyyy"))</span>
                </div>
                <div class="kv-item">
                    <span class="k">Responsabilités en cours :</span>
                    <span class="v">@Model.ResponsabilitesActuelles.Count</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== ONGLET 2 : GRADE & CARRIÈRE ===== -->
<div id="tab-grade" class="profile-tab-content">
    <div class="panel-card">
        <div class="section-header-split">
            <h4 class="panel-card-title">Historique des grades et avancements</h4>
            <button type="button" class="btn btn-sm btn-outline" onclick="openDossierModal('modal-changer-grade')">+ Nouveau grade</button>
        </div>
        @if (Model.GradePeriods.Count == 0)
        {
            <p class="text-muted mb-0">Aucune période enregistrée.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date effet</th>
                            <th>Grade</th>
                            <th>Date fin</th>
                            <th>Document</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.GradePeriods)
                        {
                            <tr>
                                <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                                <td>@gradeLabel(item.IdGrade)</td>
                                <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(Model.DocumentOf(item.IdDocument)?.NumeroDocument ?? "—")</td>
                                <td>
                                    @if (item.DateFin is null)
                                    {
                                        <span class="badge-statut-pill green">En cours</span>
                                    }
                                    else
                                    {
                                        <span class="badge-statut-pill gray">Clôturé</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ===== ONGLET 3 : RESPONSABILITÉS ===== -->
<div id="tab-responsabilites" class="profile-tab-content">
    <div class="panel-card">
        <div class="section-header-split">
            <h4 class="panel-card-title">Responsabilités juridictionnelles &amp; administratives</h4>
            <button type="button" class="btn btn-sm btn-outline" onclick="openDossierModal('modal-responsabilite')">+ Attribuer responsabilité</button>
        </div>
        @if (Model.ResponsabilitePeriods.Count == 0)
        {
            <p class="text-muted mb-0">Aucune responsabilité enregistrée.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Responsabilité</th>
                            <th>Juridiction / Entité</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Statut</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ResponsabilitePeriods)
                        {
                            <tr>
                                <td>@responsabiliteLabel(item.IdResponsabilite)</td>
                                <td>@Model.RattachementLabel(item)</td>
                                <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                                <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>
                                    @if (item.DateFin is null)
                                    {
                                        <span class="badge-statut-pill green">En cours</span>
                                    }
                                    else
                                    {
                                        <span class="badge-statut-pill gray">Clôturé</span>
                                    }
                                </td>
                                <td class="text-right">
                                    @if (item.DateFin is null)
                                    {
                                        <form method="post" asp-action="CloturerResponsabilite" asp-route-id="@f.Id" class="inline-close-form">
                                            <input type="hidden" name="idPeriode" value="@item.Id" />
                                            <input class="form-input form-input-inline" type="date" name="dateFin" value="@aujourdHui" required />
                                            <button type="submit" class="btn-table-action danger">Clôturer</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ===== ONGLET 4 : AFFECTATION ===== -->
<div id="tab-affectation" class="profile-tab-content">
    <div class="panel-card">
        <div class="section-header-split">
            <h4 class="panel-card-title">Historique des affectations et mutations</h4>
            <button type="button" class="btn btn-sm btn-outline" onclick="openDossierModal('modal-affecter')">+ Modifier affectation</button>
        </div>
        @if (Model.AffectationPeriods.Count == 0)
        {
            <p class="text-muted mb-0">Aucune affectation enregistrée.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tribunal / Unité</th>
                            <th>Section</th>
                            <th>Unité de travail</th>
                            <th>Date d'effet</th>
                            <th>Date fin</th>
                            <th>État</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AffectationPeriods)
                        {
                            <tr>
                                <td>@Model.AffectationLabel(item)</td>
                                <td>@DossierFonctionnaireViewModel.SectionLabel(item.SectionTribunal)</td>
                                <td>@(Model.UniteOf(item.IdUniteTravail)?.NomUnite ?? "—")</td>
                                <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                                <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>
                                    @if (item.DateFin is null)
                                    {
                                        <span class="badge-statut-pill green">En cours</span>
                                    }
                                    else
                                    {
                                        <span class="badge-statut-pill gray">Clôturé</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ===== ONGLET 5 : SITUATION ===== -->
<div id="tab-situation" class="profile-tab-content">
    <div class="panel-card">
        <div class="section-header-split">
            <h4 class="panel-card-title">Historique des situations administratives</h4>
            <button type="button" class="btn btn-sm btn-outline" onclick="openDossierModal('modal-situation')">+ Ouvrir une situation</button>
        </div>
        @if (Model.SituationPeriods.Count == 0)
        {
            <p class="text-muted mb-0">Aucune situation enregistrée.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Situation</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Document</th>
                            <th>État</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SituationPeriods)
                        {
                            <tr>
                                <td>@statutLabel(item.IdStatut)</td>
                                <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                                <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(Model.DocumentOf(item.IdDocument)?.NumeroDocument ?? "—")</td>
                                <td>
                                    @if (item.DateFin is null)
                                    {
                                        <span class="badge-statut-pill green">En cours</span>
                                    }
                                    else
                                    {
                                        <span class="badge-statut-pill gray">Clôturé</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ===== ONGLET 6 : RIB ===== -->
<div id="tab-rib" class="profile-tab-content">
    <div class="panel-card">
        <div class="section-header-split">
            <h4 class="panel-card-title">RIB actif &amp; historique bancaire</h4>
            <button type="button" class="btn btn-sm btn-outline" onclick="openDossierModal('modal-rib')">+ Nouveau RIB</button>
        </div>

        @if (Model.RibActif is null)
        {
            <p class="text-muted">Aucun RIB actif.</p>
        }
        else
        {
            <div class="key-value-list mb-4">
                <div class="kv-item"><span class="k">Code banque :</span><span class="v">@Model.RibActif.CodeBanque</span></div>
                <div class="kv-item"><span class="k">Code ville :</span><span class="v">@Model.RibActif.CodeVille</span></div>
                <div class="kv-item"><span class="k">Numéro de compte :</span><span class="v">@Model.RibActif.NumeroCompte</span></div>
                <div class="kv-item"><span class="k">Clé :</span><span class="v">@Model.RibActif.Cle</span></div>
            </div>
        }

        @if (Model.Ribs.Count == 0)
        {
            <p class="text-muted mb-0">Aucun RIB enregistré.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Banque</th>
                            <th>Compte</th>
                            <th>État</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rib in Model.Ribs)
                        {
                            <tr>
                                <td>@rib.CodeBanque / @rib.CodeVille</td>
                                <td>@rib.NumeroCompte (@rib.Cle)</td>
                                <td>
                                    @if (rib.EstActif)
                                    {
                                        <span class="badge-statut-pill green">Actif</span>
                                    }
                                    else
                                    {
                                        <span class="badge-statut-pill gray">Inactif</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ===== MODAL : CHANGER DE GRADE (template) ===== -->
<div id="modal-changer-grade" class="modal-overlay">
    <div class="modal-dialog">
        <div class="modal-header">
            <div>
                <h3 class="modal-title">CHANGEMENT DE GRADE</h3>
                <p class="modal-subtitle">Avancement de grade ou changement d'échelon.</p>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeDossierModal('modal-changer-grade')">×</button>
        </div>
        <form method="post" asp-action="ChangerGrade" asp-route-id="@f.Id">
            <div class="modal-body">
                <div class="form-group">
                    <label for="idGrade" class="form-label">NOUVEAU GRADE</label>
                    <select id="idGrade" name="idGrade" class="form-select" required>
                        <option value="">— Sélectionner —</option>
                        @foreach (var grade in Model.Grades)
                        {
                            <option value="@grade.Id">@grade.LibelleGradeFr (@grade.NumeroReferencie)</option>
                        }
                    </select>
                </div>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="dateDebutGrade" class="form-label">DATE D'EFFET</label>
                        <input class="form-input" type="date" id="dateDebutGrade" name="dateDebut" value="@aujourdHui" required />
                    </div>
                    <div class="form-group">
                        <label for="idDocumentGrade" class="form-label">DOCUMENT / RÉFÉRENCE</label>
                        <select class="form-select" id="idDocumentGrade" name="idDocument">
                            <option value="">— Aucun —</option>
                            @foreach (var document in Model.Documents)
                            {
                                <option value="@document.Id">@document.NumeroDocument — @document.Emetteur (@document.AnneeDocument)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeDossierModal('modal-changer-grade')">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer le grade</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== MODAL : ATTRIBUER UNE RESPONSABILITÉ (template) ===== -->
<div id="modal-responsabilite" class="modal-overlay">
    <div class="modal-dialog">
        <div class="modal-header">
            <div>
                <h3 class="modal-title">ATTRIBUTION DE RESPONSABILITÉ</h3>
                <p class="modal-subtitle">Conférer une charge de direction juridictionnelle ou administrative.</p>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeDossierModal('modal-responsabilite')">×</button>
        </div>
        <form method="post" asp-action="AjouterResponsabilite" asp-route-id="@f.Id">
            <div class="modal-body">
                <div class="form-group">
                    <label for="idResponsabilite" class="form-label">TITRE DE LA RESPONSABILITÉ</label>
                    <select id="idResponsabilite" name="idResponsabilite" class="form-select" required>
                        <option value="">— Sélectionner —</option>
                        @foreach (var responsabilite in Model.Responsabilites)
                        {
                            <option value="@responsabilite.Id">@responsabilite.LibelleResponsabiliteFr (@responsabilite.CodeResponsabilite)</option>
                        }
                    </select>
                </div>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="idTribunalResponsabilite" class="form-label">JURIDICTION</label>
                        <select class="form-select" id="idTribunalResponsabilite" name="idTribunal">
                            <option value="">— Aucune —</option>
                            @foreach (var tribunal in Model.Tribunaux)
                            {
                                <option value="@tribunal.Id">@tribunal.NomTribunal</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="idUniteResponsabilite" class="form-label">UNITÉ ORGANISATIONNELLE</label>
                        <select class="form-select" id="idUniteResponsabilite" name="idUniteOrganisationnelle">
                            <option value="">— Aucune —</option>
                            @foreach (var unite in Model.Unites)
                            {
                                <option value="@unite.Id">@unite.NomUnite</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="dateDebutResponsabilite" class="form-label">DATE DE DÉBUT</label>
                        <input class="form-input" type="date" id="dateDebutResponsabilite" name="dateDebut" value="@aujourdHui" required />
                    </div>
                    <div class="form-group">
                        <label for="dateFinResponsabilite" class="form-label">DATE DE FIN (SI DÉTERMINÉE)</label>
                        <input class="form-input" type="date" id="dateFinResponsabilite" name="dateFin" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="idDocumentResponsabilite" class="form-label">DOCUMENT / RÉFÉRENCE</label>
                    <select class="form-select" id="idDocumentResponsabilite" name="idDocument">
                        <option value="">— Aucun —</option>
                        @foreach (var document in Model.Documents)
                        {
