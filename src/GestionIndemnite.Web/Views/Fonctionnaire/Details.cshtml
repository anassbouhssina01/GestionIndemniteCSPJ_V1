@section Scripts {
    <script>
        (function () {
            "use strict";

            // --- Onglets du dossier (même comportement que le template) ---
            var tabs = document.querySelectorAll("#dossier-tabs .profile-tab");
            var contents = document.querySelectorAll(".profile-tab-content");

            function activateTab(tabId, updateHash) {
                var found = false;
                Array.prototype.forEach.call(tabs, function (tab) {
                    var isActive = tab.getAttribute("data-tab") === tabId;
                    tab.classList.toggle("active", isActive);
                    if (isActive) { found = true; }
                });
                if (!found) { return; }

                Array.prototype.forEach.call(contents, function (content) {
                    content.classList.toggle("active", content.id === tabId);
                });

                if (updateHash) {
                    history.replaceState(null, "", "#" + tabId);
                }
            }

            Array.prototype.forEach.call(tabs, function (tab) {
                tab.addEventListener("click", function () {
                    activateTab(tab.getAttribute("data-tab"), true);
                });
            });

            var hash = (window.location.hash || "").replace("#", "");
            if (hash && document.getElementById(hash)) {
                activateTab(hash, false);
            }

            // --- Modales (même mécanique que le template) ---
            window.openDossierModal = function (modalId) {
                var modal = document.getElementById(modalId);
                if (!modal) { return; }
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
                var firstField = modal.querySelector("select, input, textarea");
                if (firstField) { firstField.focus(); }
            };

            window.closeDossierModal = function (modalId) {
                var modal = document.getElementById(modalId);
                if (!modal) { return; }
                modal.classList.remove("active");
                document.body.style.overflow = "";
            };

            Array.prototype.forEach.call(document.querySelectorAll(".modal-overlay"), function (overlay) {
                overlay.addEventListener("click", function (event) {
                    if (event.target === overlay) {
                        closeDossierModal(overlay.id);
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    Array.prototype.forEach.call(
                        document.querySelectorAll(".modal-overlay.active"),
                        function (overlay) { closeDossierModal(overlay.id); });
                }
            });

            // --- Tribunal OU unité (jamais les deux) ---
            function exclusive(firstId, secondId) {
                var first = document.getElementById(firstId);
                var second = document.getElementById(secondId);
                if (!first || !second) { return; }
                first.addEventListener("change", function () {
                    if (first.value) { second.value = ""; }
                });
                second.addEventListener("change", function () {
                    if (second.value) { first.value = ""; }
                });
            }

            exclusive("idTribunalAffectation", "idUniteAffectation");
            exclusive("idTribunalResponsabilite", "idUniteResponsabilite");
        })();
    </script>
}
