@{
    ViewData["Title"] = "Nouveau grade";
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">NOUVEAU GRADE</h2>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Index">Retour à la liste</a>
    </div>
</div>

<form method="post" class="panel-card form-panel">
    <div class="form-group">
        <label class="form-label" for="IdCadre">Cadre</label>
        <select class="form-select" id="IdCadre" name="IdCadre" asp-items="ViewBag.FiltreCadres" required>
            <option value="">— Sélectionner —</option>
        </select>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NumeroReferencie">Numéro de référence</label>
            <input class="form-input" id="NumeroReferencie" name="NumeroReferencie" type="number" min="1" required />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label" for="LibelleGradeFr">Libellé (français)</label>
        <input class="form-input" id="LibelleGradeFr" name="LibelleGradeFr" maxlength="200" required />
    </div>
    <div class="form-group">
        <label class="form-label" for="LibelleGradeAr">Libellé (arabe)</label>
        <input class="form-input arabic-font" id="LibelleGradeAr" name="LibelleGradeAr" maxlength="200" dir="rtl" required />
    </div>
    <div class="form-group">
        <label class="form-label" for="Description">Description</label>
        <textarea class="form-textarea" id="Description" name="Description" maxlength="1000" rows="3"></textarea>
    </div>
    <div class="page-actions-group mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-dark" asp-action="Index">Annuler</a>
    </div>
</form>
