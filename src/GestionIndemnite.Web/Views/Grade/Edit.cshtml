@model GestionIndemnite.Application.RHOrganisation.DTOs.GradeDto
@{
    ViewData["Title"] = "Modifier le grade";
    var cadres = (Dictionary<Guid, string>)ViewBag.Cadres;
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">MODIFIER LE GRADE</h2>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Index">Retour à la liste</a>
    </div>
</div>

<form method="post" asp-route-id="@Model.Id" class="panel-card form-panel">
    <div class="form-group">
        <label class="form-label">Cadre</label>
        <input class="form-input" value="@(cadres.TryGetValue(Model.IdCadre, out var nomCadre) ? nomCadre : Model.IdCadre.ToString())" readonly />
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NumeroReferencie">Numéro de référence</label>
            <input class="form-input" id="NumeroReferencie" name="NumeroReferencie" type="number" min="1" value="@Model.NumeroReferencie" required />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label" for="LibelleGradeFr">Libellé (français)</label>
        <input class="form-input" id="LibelleGradeFr" name="LibelleGradeFr" maxlength="200" value="@Model.LibelleGradeFr" required />
    </div>
    <div class="form-group">
        <label class="form-label" for="LibelleGradeAr">Libellé (arabe)</label>
        <input class="form-input arabic-font" id="LibelleGradeAr" name="LibelleGradeAr" maxlength="200" dir="rtl" value="@Model.LibelleGradeAr" required />
    </div>
    <div class="form-group">
        <label class="form-label" for="Description">Description</label>
        <textarea class="form-textarea" id="Description" name="Description" maxlength="1000" rows="3">@Model.Description</textarea>
    </div>
    <div class="form-check mt-3">
        <input type="hidden" name="EstActif" value="false" />
        <input class="form-check-input" type="checkbox" id="EstActif" name="EstActif" value="true" @(Model.EstActif ? "checked" : "") />
        <label class="form-check-label" for="EstActif">Actif</label>
    </div>
    <div class="page-actions-group mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-dark" asp-action="Index">Annuler</a>
    </div>
</form>
