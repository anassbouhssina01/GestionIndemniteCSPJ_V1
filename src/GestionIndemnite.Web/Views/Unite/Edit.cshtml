@model GestionIndemnite.Application.RHOrganisation.DTOs.UniteOrganisationnelleDto
@{
    ViewData["Title"] = "Modifier l'unité organisationnelle";
    var dateCreation = Model.DateCreation?.ToString("yyyy-MM-dd") ?? string.Empty;
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">MODIFIER L'UNITÉ ORGANISATIONNELLE</h2>
        <p class="page-description">@Model.NomUnite</p>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Index">Retour à la liste</a>
    </div>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="panel-card form-panel">
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NomUnite">Nom de l'unité (français)</label>
            <input class="form-input" id="NomUnite" name="NomUnite"
                   maxlength="200" value="@Model.NomUnite" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="NomUniteAr">Nom de l'unité (arabe)</label>
            <input class="form-input arabic-font" id="NomUniteAr" name="NomUniteAr"
                   maxlength="200" dir="rtl" value="@Model.NomUniteAr" />
        </div>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="DateCreation">Date de création</label>
            <input class="form-input" type="date" id="DateCreation" name="DateCreation"
                   value="@dateCreation" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="TypeUnite">Type</label>
            <select class="form-select" id="TypeUnite" name="TypeUnite" asp-items="ViewBag.Types" required>
                <option value="">— Sélectionner —</option>
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="form-label" for="IdVille">Ville</label>
        <select class="form-select" id="IdVille" name="IdVille" asp-items="ViewBag.Villes" required>
            <option value="">— Sélectionner —</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Rattachement hiérarchique</label>
        <p class="text-muted mb-0">
            Le parent se modifie avec une date d'effet dans l'historique de l'organigramme.
            <a asp-controller="HistoriqueOrganigrammeUnite" asp-action="Index" asp-route-id="@Model.Id">Gérer le rattachement</a>
        </p>
    </div>
    <div class="page-actions-group mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-dark" asp-action="Index">Annuler</a>
    </div>
</form>
