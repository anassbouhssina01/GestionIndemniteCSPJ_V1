@model IReadOnlyList<GestionIndemnite.Application.RHOrganisation.DTOs.StatutAdministratifDto>
@{
    ViewData["Title"] = "Statuts administratifs";
    var inactifs = (bool)(ViewData["Inactifs"] ?? false);
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">STATUTS ADMINISTRATIFS</h2>
        <p class="page-description">Statuts administratifs des fonctionnaires.</p>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-primary" asp-action="Create">Nouveau statut</a>
    </div>
</div>

<form method="get" class="filter-toolbar">
    <div class="filter-group">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="inactifs" value="true" id="inactifs" @(inactifs ? "checked" : "") onchange="this.form.submit()" />
            <label class="form-check-label" for="inactifs">Afficher les inactifs</label>
        </div>
    </div>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Libellé (arabe)</th>
                    <th>Libellé (français)</th>
                    <th>Description</th>
                    <th>État</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted">Aucun statut administratif.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CodeStatut</td>
                        <td dir="rtl">@item.LibelleStatutAr</td>
                        <td>@item.LibelleStatutFr</td>
                        <td>@item.Description</td>
                        <td>
                            @if (item.EstActif)
                            {
                                <span class="badge-statut-pill green">Actif</span>
                            }
                            else
                            {
                                <span class="badge-statut-pill gray">Inactif</span>
                            }
                        </td>
                        <td class="text-right">
                            <a class="btn-table-action" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>
                            @if (item.EstActif)
                            {
                                <form method="post" asp-action="Disable" asp-route-id="@item.Id">
                                    <button type="submit" class="btn-table-action danger">Désactiver</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="Enable" asp-route-id="@item.Id">
                                    <button type="submit" class="btn-table-action">Activer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
