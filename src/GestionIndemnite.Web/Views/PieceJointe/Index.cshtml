@model IReadOnlyList<GestionIndemnite.Application.RHOrganisation.DTOs.PieceJointeDto>
@{
    ViewData["Title"] = "Documents";
    var numeroDocument = (string?)ViewBag.NumeroDocument;
    var emetteur = (string?)ViewBag.Emetteur;
    var annee = (int?)ViewBag.Annee;
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">BUREAU D'ORDRE</h2>
        <p class="page-description">Documents justificatifs rattachés aux dossiers des fonctionnaires.</p>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-primary" asp-action="Create">Téléverser un document</a>
    </div>
</div>

<form method="get" class="filter-toolbar">
    <div class="filter-group">
        <label class="filter-label" for="numeroDocument">Numéro de document</label>
        <input class="form-input" id="numeroDocument" name="numeroDocument" value="@numeroDocument" />
    </div>
    <div class="filter-group">
        <label class="filter-label" for="emetteur">Émetteur</label>
        <input class="form-input" id="emetteur" name="emetteur" value="@emetteur" />
    </div>
    <div class="filter-group">
        <label class="filter-label" for="annee">Année</label>
        <input class="form-input" id="annee" name="annee" type="number" min="1900" max="2100" value="@annee" />
    </div>
    <div class="filter-group">
        <button type="submit" class="btn btn-outline btn-sm">Rechercher</button>
    </div>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Numéro</th>
                    <th>Date du document</th>
                    <th>Émetteur</th>
                    <th>Type</th>
                    <th>Objet</th>
                    <th>Ajouté le</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted">Aucun document.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NumeroDocument</td>
                        <td>@item.DateDocument.ToString("dd/MM/yyyy") (@item.AnneeDocument)</td>
                        <td>@item.Emetteur</td>
                        <td>@item.TypeDocument</td>
                        <td>@item.Objet</td>
                        <td>@item.DateAjout.ToString("dd/MM/yyyy")</td>
                        <td class="text-right">
                            <a class="btn-table-action" asp-action="Download" asp-route-id="@item.Id">Télécharger</a>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id">
                                <button type="submit" class="btn-table-action danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
