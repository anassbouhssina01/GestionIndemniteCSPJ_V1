@model GestionIndemnite.Application.RHOrganisation.DTOs.TribunalDto
@{
    ViewData["Title"] = "Modifier le tribunal";
    var dateCreation = Model.DateCreation?.ToString("yyyy-MM-dd") ?? string.Empty;
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">MODIFIER LE TRIBUNAL</h2>
        <p class="page-description">@Model.NomTribunal</p>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Index">Retour à la liste</a>
    </div>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="panel-card form-panel">
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NumeroTribunal">Numéro du tribunal</label>
            <input class="form-input" id="NumeroTribunal" name="NumeroTribunal"
                   maxlength="50" value="@Model.NumeroTribunal" placeholder="Ex. 101" />
        </div>
        <div class="form-group">
            <label class="form-label" for="DateCreation">Date de création</label>
            <input class="form-input" type="date" id="DateCreation" name="DateCreation"
                   value="@dateCreation" required />
        </div>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="NomTribunal">Nom du tribunal (français)</label>
            <input class="form-input" id="NomTribunal" name="NomTribunal"
                   maxlength="200" value="@Model.NomTribunal" required />
        </div>
        <div class="form-group">
            <label class="form-label" for="NomTribunalAr">Nom du tribunal (arabe)</label>
            <input class="form-input arabic-font" id="NomTribunalAr" name="NomTribunalAr"
                   maxlength="200" dir="rtl" value="@Model.NomTribunalAr" />
        </div>
    </div>
    <div class="form-grid-2">
        <div class="form-group">
            <label class="form-label" for="TypeTribunal">Type</label>
            <select class="form-select" id="TypeTribunal" name="TypeTribunal" asp-items="ViewBag.Types" required>
                <option value="">— Sélectionner —</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label" for="NiveauJuridiction">Niveau de juridiction</label>
            <select class="form-select" id="NiveauJuridiction" name="NiveauJuridiction" asp-items="ViewBag.Niveaux" required>
                <option value="">— Sélectionner —</option>
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="form-label" for="IdVille">Ville</label>
        <select class="form-select" id="IdVille" name="IdVille" asp-items="ViewBag.Villes" required>
            <option value="">— Sélectionner —</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Rattachement hiérarchique</label>
        <p class="text-muted mb-0">
            Le parent se modifie avec une date d'effet dans l'historique de l'organigramme.
            <a asp-controller="HistoriqueOrganigrammeTribunal" asp-action="Index" asp-route-id="@Model.Id">Gérer le rattachement</a>
        </p>
    </div>
    <div class="page-actions-group mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-dark" asp-action="Index">Annuler</a>
    </div>
</form>
