@model IReadOnlyList<GestionIndemnite.Application.RHOrganisation.DTOs.HistoriqueResponsabiliteDto>
@using GestionIndemnite.Application.RHOrganisation.DTOs
@{
    ViewData["Title"] = "Historique des responsabilités";
    var fonctionnaire = (FonctionnaireDto?)ViewData["Fonctionnaire"];
}

@if (fonctionnaire is null)
{
    <div class="page-header-row">
        <div class="page-title-group">
            <h2 class="page-title-serif">HISTORIQUE DES RESPONSABILITÉS</h2>
            <p class="page-description">Sélectionnez un fonctionnaire pour consulter et compléter son historique des responsabilités.</p>
        </div>
    </div>
    @await Html.PartialAsync("_RechercheFonctionnaire")
}
else
{
    var responsabilites = (IReadOnlyList<ResponsabiliteDto>)ViewBag.Responsabilites;
    var tribunaux = (IReadOnlyList<TribunalDto>)ViewBag.Tribunaux;
    var unites = (IReadOnlyList<UniteOrganisationnelleDto>)ViewBag.Unites;
    var documents = (IReadOnlyList<PieceJointeDto>)ViewBag.Documents;

    <div class="page-header-row">
        <div class="page-title-group">
            <h2 class="page-title-serif">RESPONSABILITÉS</h2>
            <p class="page-description">@fonctionnaire.Matricule @fonctionnaire.NomFr @fonctionnaire.PrenomFr</p>
        </div>
        <div class="page-actions-group">
            <a class="btn btn-outline-dark" asp-action="Index">Changer de fonctionnaire</a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Responsabilité</th>
                        <th>Rattachée à</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Document</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted">Aucune période enregistrée.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        var responsabilite = responsabilites.FirstOrDefault(r => r.Id == item.IdResponsabilite);
                        var rattachement = item.IdTribunal.HasValue
                            ? tribunaux.FirstOrDefault(t => t.Id == item.IdTribunal)?.NomTribunal
                            : unites.FirstOrDefault(u => u.Id == item.IdUniteOrganisationnelle)?.NomUnite;
                        var document = documents.FirstOrDefault(d => d.Id == item.IdDocument);
                        <tr>
                            <td>@(responsabilite is null ? "—" : $"{responsabilite.LibelleResponsabiliteFr} ({responsabilite.CodeResponsabilite})")</td>
                            <td>@(rattachement ?? "—")</td>
                            <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                            <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@(document?.NumeroDocument ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel-card mt-4">
        <h4 class="panel-card-title">Ajouter une responsabilité</h4>
        <p class="page-description">Remplir exactement l'un des deux champs : tribunal ou unité organisationnelle.</p>
        <form method="post" asp-action="Ajouter" asp-route-id="@fonctionnaire.Id">
            <div class="form-group">
                <label class="form-label" for="IdResponsabilite">Responsabilité</label>
                <select class="form-select" id="IdResponsabilite" name="IdResponsabilite" required>
                    <option value="">— Sélectionner —</option>
                    @foreach (var responsabilite in responsabilites)
                    {
                        <option value="@responsabilite.Id">@responsabilite.LibelleResponsabiliteFr (@responsabilite.CodeResponsabilite)</option>
                    }
                </select>
            </div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label" for="IdTribunal">Tribunal</label>
                    <select class="form-select" id="IdTribunal" name="IdTribunal">
                        <option value="">—</option>
                        @foreach (var tribunal in tribunaux)
                        {
                            <option value="@tribunal.Id">@tribunal.NomTribunal</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="IdUniteOrganisationnelle">Unité organisationnelle</label>
                    <select class="form-select" id="IdUniteOrganisationnelle" name="IdUniteOrganisationnelle">
                        <option value="">—</option>
                        @foreach (var unite in unites)
                        {
                            <option value="@unite.Id">@unite.NomUnite</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-grid-3">
                <div class="form-group">
                    <label class="form-label" for="DateDebut">Début</label>
                    <input class="form-input" type="date" id="DateDebut" name="DateDebut" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="DateFin">Fin</label>
                    <input class="form-input" type="date" id="DateFin" name="DateFin" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="IdDocument">Document (optionnel)</label>
                    <select class="form-select" id="IdDocument" name="IdDocument">
                        <option value="">—</option>
                        @foreach (var document in documents)
                        {
                            <option value="@document.Id">@document.NumeroDocument — @document.Emetteur (@document.AnneeDocument)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="page-actions-group mt-4">
                <button type="submit" class="btn btn-primary">Ajouter</button>
            </div>
        </form>
    </div>
}
