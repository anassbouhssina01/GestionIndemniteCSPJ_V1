@model IReadOnlyList<GestionIndemnite.Application.RHOrganisation.DTOs.ParentOrganigrammeDto>
@using GestionIndemnite.Application.RHOrganisation.DTOs
@{
    ViewData["Title"] = "Historique de l'organigramme";
    var tribunal = (TribunalDto)ViewData["Tribunal"]!;
    var parentActuel = (ParentOrganigrammeDto?)ViewBag.ParentActuel;
    var candidats = (IReadOnlyList<TribunalDto>)ViewBag.Candidats;
    var documents = (IReadOnlyList<PieceJointeDto>)ViewBag.Documents;
}

<div class="page-header-row">
    <div class="page-title-group">
        <h2 class="page-title-serif">ORGANIGRAMME</h2>
        <p class="page-description">@tribunal.NomTribunal</p>
    </div>
    <div class="page-actions-group">
        <a class="btn btn-outline-dark" asp-action="Index">Changer de tribunal</a>
    </div>
</div>

<div class="panel-card">
    <h4 class="panel-card-title">Parent actuel</h4>
    @if (parentActuel is null)
    {
        <p class="text-muted mb-0">Aucun parent : ce tribunal est à la racine de l'organigramme.</p>
    }
    else
    {
        <p class="mb-0">
            @parentActuel.Nom
            <span class="text-muted"> (depuis le @parentActuel.DateDebut.ToString("dd/MM/yyyy"))</span>
        </p>
    }
</div>

<div class="panel-card">
    <h4 class="panel-card-title">Changer le parent (à compter d'une date)</h4>
    <form method="post" asp-action="ChangerParent" asp-route-id="@tribunal.Id">
        <div class="form-grid-3">
            <div class="form-group">
                <label class="form-label" for="IdTribunalParent">Nouveau parent</label>
                <select class="form-select" id="IdTribunalParent" name="IdTribunalParent">
                    <option value="">— Aucun (racine) —</option>
                    @foreach (var candidat in candidats)
                    {
                        <option value="@candidat.Id">@candidat.NomTribunal</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="DateDebut">Date d'effet</label>
                <input class="form-input" type="date" id="DateDebut" name="DateDebut" required />
            </div>
            <div class="form-group">
                <label class="form-label" for="IdDocument">Document (optionnel)</label>
                <select class="form-select" id="IdDocument" name="IdDocument">
                    <option value="">—</option>
                    @foreach (var document in documents)
                    {
                        <option value="@document.Id">@document.NumeroDocument — @document.Emetteur (@document.AnneeDocument)</option>
                    }
                </select>
            </div>
        </div>
        <div class="page-actions-group mt-4">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
    </form>
</div>

<div class="panel-card">
    <h4 class="panel-card-title">Historique des rattachements</h4>
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">Aucun rattachement enregistré.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Parent</th>
                        <th>Début</th>
                        <th>Fin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Id == Guid.Empty ? "— (racine)" : item.Nom)</td>
                            <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                            <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
