@model IReadOnlyList<GestionIndemnite.Application.RHOrganisation.DTOs.HistoriqueCadreGradeDto>
@using GestionIndemnite.Application.RHOrganisation.DTOs
@{
    ViewData["Title"] = "Historique des grades";
    var fonctionnaire = (FonctionnaireDto?)ViewData["Fonctionnaire"];
}

@if (fonctionnaire is null)
{
    <div class="page-header-row">
        <div class="page-title-group">
            <h2 class="page-title-serif">HISTORIQUE DES GRADES</h2>
            <p class="page-description">Sélectionnez un fonctionnaire pour consulter et compléter son historique des grades.</p>
        </div>
    </div>
    @await Html.PartialAsync("_RechercheFonctionnaire")
}
else
{
    var grades = (IReadOnlyList<GradeDto>)ViewBag.Grades;
    var documents = (IReadOnlyList<PieceJointeDto>)ViewBag.Documents;

    <div class="page-header-row">
        <div class="page-title-group">
            <h2 class="page-title-serif">GRADES</h2>
            <p class="page-description">@fonctionnaire.Matricule @fonctionnaire.NomFr @fonctionnaire.PrenomFr</p>
        </div>
        <div class="page-actions-group">
            <a class="btn btn-outline-dark" asp-action="Index">Changer de fonctionnaire</a>
        </div>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Grade</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Document</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted">Aucune période enregistrée.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        var grade = grades.FirstOrDefault(g => g.Id == item.IdGrade);
                        var document = documents.FirstOrDefault(d => d.Id == item.IdDocument);
                        <tr>
                            <td>@(grade is null ? "—" : $"{grade.LibelleGradeFr} ({grade.NumeroReferencie})")</td>
                            <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                            <td>@(item.DateFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@(document?.NumeroDocument ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel-card mt-4">
        <h4 class="panel-card-title">Ajouter une période de grade</h4>
        <form method="post" asp-action="Ajouter" asp-route-id="@fonctionnaire.Id">
            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label" for="IdGrade">Grade</label>
                    <select class="form-select" id="IdGrade" name="IdGrade" required>
                        <option value="">— Sélectionner —</option>
                        @foreach (var grade in grades)
                        {
                            <option value="@grade.Id">@grade.LibelleGradeFr (@grade.NumeroReferencie)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="IdDocument">Document (optionnel)</label>
                    <select class="form-select" id="IdDocument" name="IdDocument">
                        <option value="">—</option>
                        @foreach (var document in documents)
                        {
                            <option value="@document.Id">@document.NumeroDocument — @document.Emetteur (@document.AnneeDocument)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-grid-2">
                <div class="form-group">
                    <label class="form-label" for="DateDebut">Début</label>
                    <input class="form-input" type="date" id="DateDebut" name="DateDebut" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="DateFin">Fin</label>
                    <input class="form-input" type="date" id="DateFin" name="DateFin" />
                </div>
            </div>
            <div class="page-actions-group mt-4">
                <button type="submit" class="btn btn-primary">Ajouter</button>
            </div>
        </form>
    </div>
}
