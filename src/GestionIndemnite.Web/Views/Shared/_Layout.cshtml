@{
    var controller = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    var pageTitle = ViewData["Title"] as string ?? "Tableau de bord";

    string NavClass(string c) => controller.Equals(c, System.StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";
    string SubNavClass(string c) => controller.Equals(c, System.StringComparison.OrdinalIgnoreCase) ? "sub-nav-item active" : "sub-nav-item";

    var referentiels = new[] { "Tribunal", "Unite", "StatutAdministratif", "Pays", "Ville", "Cadre", "Grade", "Responsabilite" };
    var historiques = new[] { "HistoriqueCadreGrade", "SituationAdministrative", "HistoriqueAffectation", "HistoriqueResponsabilite", "HistoriqueOrganigrammeTribunal", "HistoriqueOrganigrammeUnite" };
    var rapports = new[] { "Rapport", "Import" };

    var referentielsOpen = System.Array.IndexOf(referentiels, controller) >= 0 ? "open" : string.Empty;
    var historiquesOpen = System.Array.IndexOf(historiques, controller) >= 0 ? "open" : string.Empty;
    var rapportsOpen = System.Array.IndexOf(rapports, controller) >= 0 ? "open" : string.Empty;

    var dateFr = DateTime.Now.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Gestion des indemnités</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div id="app" class="app-layout">
        <!-- SIDEBAR -->
        <aside id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo-circle">
                    <span>C</span>
                </div>
                <div class="brand-text-block">
                    <h1 class="brand-title">CSPJ</h1>
                    <p class="brand-subtitle">GESTION INDEMNITÉS</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">MENU PRINCIPAL</div>
                <ul class="nav-list">
                    <li>
                        <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            </svg>
                            <span>Tableau de bord</span>
                        </a>
                    </li>
                </ul>

                @* <div class="nav-section-title">GESTION FONCTIONNAIRE</div> *@
                <ul class="nav-list">
                    <li>
                        <a class="@NavClass("Fonctionnaire")" asp-controller="Fonctionnaire" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>Fonctionnaires</span>
                        </a>
                    </li>
                </ul>

                @* <div class="nav-section-title">BUREAU D'ORDRE</div> *@
                <ul class="nav-list">
                    <li>
                        <a class="@NavClass("PieceJointe")" asp-controller="PieceJointe" asp-action="Index">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>Bureau d'ordre</span>
                        </a>
                    </li>
                </ul>

                @* <div class="nav-section-title">PARAMÉTRAGE</div> *@
                <ul class="nav-list">
                    <li class="nav-group-parent">
                        <button type="button" class="nav-item nav-parent-item @referentielsOpen" data-submenu-toggle="#submenu-parametrage">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                            <span>Paramétrage</span>
                            <svg class="chevron-sub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <ul class="sub-nav-list @referentielsOpen" id="submenu-parametrage">
                            <li>
                                <a class="@SubNavClass("Tribunal")" asp-controller="Tribunal" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Tribunaux</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Unite")" asp-controller="Unite" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Unités organisationnelles</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("StatutAdministratif")" asp-controller="StatutAdministratif" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Statuts administratifs</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Pays")" asp-controller="Pays" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Pays</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Ville")" asp-controller="Ville" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Villes</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Cadre")" asp-controller="Cadre" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Cadres</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Grade")" asp-controller="Grade" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Grades</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Responsabilite")" asp-controller="Responsabilite" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Responsabilités</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

                @* <div class="nav-section-title">HISTORIQUES</div>
                <ul class="nav-list">
                    <li class="nav-group-parent">
                        <button type="button" class="nav-item nav-parent-item @historiquesOpen" data-submenu-toggle="#submenu-historiques">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>Historiques</span>
                            <svg class="chevron-sub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <ul class="sub-nav-list @historiquesOpen" id="submenu-historiques">
                            <li>
                                <a class="@SubNavClass("HistoriqueCadreGrade")" asp-controller="HistoriqueCadreGrade" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Grades (cadre)</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("SituationAdministrative")" asp-controller="SituationAdministrative" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Situations administratives</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("HistoriqueAffectation")" asp-controller="HistoriqueAffectation" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Affectations</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("HistoriqueResponsabilite")" asp-controller="HistoriqueResponsabilite" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Responsabilités</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("HistoriqueOrganigrammeTribunal")" asp-controller="HistoriqueOrganigrammeTribunal" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Organigramme (tribunaux)</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("HistoriqueOrganigrammeUnite")" asp-controller="HistoriqueOrganigrammeUnite" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Organigramme (unités)</span>
                                </a>
                            </li>
                        </ul>
                    </li> *@
                @* </ul> *@

                @* <div class="nav-section-title">RAPPORTS &amp; IMPORT</div> *@
                <ul class="nav-list">
                    <li class="nav-group-parent">
                        <button type="button" class="nav-item nav-parent-item @rapportsOpen" data-submenu-toggle="#submenu-rapports">
                            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="8" y1="13" x2="16" y2="13"></line>
                                <line x1="8" y1="17" x2="13" y2="17"></line>
                            </svg>
                            <span>Rapports</span>
                            <svg class="chevron-sub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <ul class="sub-nav-list @rapportsOpen" id="submenu-rapports">
                            <li>
                                <a class="@SubNavClass("Rapport")" asp-controller="Rapport" asp-action="Trous">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Trous de carrière</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Rapport")" asp-controller="Rapport" asp-action="SansJustificatif">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Sans justificatif</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Rapport")" asp-controller="Rapport" asp-action="Chevauchements">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Chevauchements</span>
                                </a>
                            </li>
                            <li>
                                <a class="@SubNavClass("Import")" asp-controller="Import" asp-action="Index">
                                    <span class="sub-nav-indicator"></span><span class="sub-nav-text">Import Excel</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <span>© 2026 — RH CSPJ</span>
                <span class="version-tag">v1.0</span>
            </div>
        </aside>

        <!-- MAIN WRAPPER -->
        <div class="main-wrapper" id="main-wrapper">
            <header class="top-navbar">
                <div class="navbar-left">
                    <button type="button" id="btn-toggle-sidebar" class="btn-icon-nav" aria-label="Basculer le menu">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <nav class="breadcrumb-nav" aria-label="Fil d'ariane">
                        <a class="breadcrumb-item link" asp-controller="Home" asp-action="Index">Accueil</a>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-item current">@pageTitle</span>
                    </nav>
                </div>

                <div class="navbar-right">
                    <div class="current-date-badge">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>@dateFr</span>
                    </div>
                    <div class="user-profile-badge">
                        <div class="user-avatar-small">RH</div>
                        <div class="user-info-text">
                            <span class="user-name">Direction RH &amp; BO</span>
                            <span class="user-role">Rabat · Siège</span>
                        </div>
                    </div>
                </div>
            </header>

<main class="content-area" id="main-content">
        <section class="app-view active">
            <partial name="_Notification" />
            <div id="toast-container" class="toast-container"></div>
            @RenderBody()
        </section>
    </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
