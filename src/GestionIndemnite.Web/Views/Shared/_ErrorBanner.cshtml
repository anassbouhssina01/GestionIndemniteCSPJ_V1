@{
    var erreur = TempData["Erreur"] as string;
    var succes = TempData["Succes"] as string;
}

@if (!string.IsNullOrEmpty(erreur))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" dir="rtl">
        @erreur
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

@if (!string.IsNullOrEmpty(succes))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @succes
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}
